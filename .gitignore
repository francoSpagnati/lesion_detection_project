# --- Segreti ---------------------------------------------------------------
.env
*.key

# --- Dati -------------------------------------------------------------------
# I sorgenti stanno su /data01 in sola lettura e non vanno versionati.
# data/raw/ contiene symlink a /data01, tranne data/raw/DBB/ che sono 4.4 GB
# di file veri scaricati da brainlife (rigenerabili con scripts/download_dbb.py).
data/raw/

# Dataset nnU-Net convertiti: rigenerabili dal notebook e dagli script di
# conversione. Le immagini sono symlink, le label sono derivate.
# Si versiona solo il dataset.json, che documenta la conversione.
data/processed/nnUNet_raw/*
!data/processed/nnUNet_raw/*/
data/processed/nnUNet_raw/*/*
!data/processed/nnUNet_raw/*/dataset.json

# Figure di QC: rigenerabili dal notebook, binarie.
data/processed/qc/

# --- nnU-Net ----------------------------------------------------------------
# Fingerprint, piani, dati preprocessati, checkpoint: decine di GB, rigenerabili.
# Eccezione: splits_final.json NON va perso. I fold non si rigenerano, perche'
# se cambiano i confronti fra run precedenti e successive perdono validita'.
nnUNet/*
!nnUNet/nnUNet_preprocessed/
nnUNet/nnUNet_preprocessed/*
!nnUNet/nnUNet_preprocessed/*/
nnUNet/nnUNet_preprocessed/*/*
!nnUNet/nnUNet_preprocessed/*/splits_final.json

# --- Output di esecuzione ---------------------------------------------------
wandb/
logs/
models/
*.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
*.egg-info/

# Figure di confronto predizione/ground truth: rigenerabili con
# scripts/plot_predictions.py, binarie e pesanti.
reports/figures/

# --- SynthStrip -------------------------------------------------------------
# Pesi del modello (30 MB, binari): si riscaricano da
# https://surfer.nmr.mgh.harvard.edu/docs/synthstrip/ come synthstrip.1.pt.
synthstrip.1.pt
*.pt

# Maschere di skull stripping: 244 NIfTI rigenerabili con
# scripts/run_synthstrip.py. Si versionano solo il report e il CSV di metriche.
data/processed/synthstrip/

# Preprocessing AInCP: immagini N4/registrate e campi di deformazione, ~250 MB
# per soggetto, rigenerabili con scripts/preprocess_aincp.py. Si versionano solo
# i manifesti, che sono il verbale di che cosa ha fatto la pipeline su ogni caso.
data/processed/AINCP/*
data/processed/AINCP/*/*
!data/processed/AINCP/*/
!data/processed/AINCP/*/manifesto.json
!data/processed/AINCP/manifesti.json

# --- Esportazioni per 3D Slicer ----------------------------------------------
# Immagini e segmentazioni di pazienti, rigenerabili con scripts/esporta_slicer_506.py.
esportazioni/

# Fuori da GitHub: immagini di pazienti, immagini ATLAS (licenza), metadati dei pazienti
data/processed/inferenza_15T/
notebooks/aincp_primo_lotto.ipynb
docs/AINCP_SERIES_TYPE_dataset_FSM_v1.xlsx
docs/AINCP_SERIES_TYPE_dataset_FSM_v2.xlsx
docs/pipeline_preprocessing.docx
*.xlsx
*.docx
